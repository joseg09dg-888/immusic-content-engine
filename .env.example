# IM Music Content Engine — Variables de entorno
# Copia este archivo como .env y rellena los valores reales

# Claude API
ANTHROPIC_API_KEY=

# Google (Drive + YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# Meta (Instagram)
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# TikTok
TIKTOK_ACCESS_TOKEN=

# ElevenLabs (voz en off)
ELEVENLABS_API_KEY=

# Pexels (imágenes B-roll)
PEXELS_API_KEY=

# Unsplash (imágenes B-roll)
UNSPLASH_ACCESS_KEY=

# Cuenta IM Music
IM_MUSIC_EMAIL=immusicsello@gmail.com

# Paths
ASSETS_DIR=./assets
RELEASES_DIR=./releases
LOGS_DIR=./logs
